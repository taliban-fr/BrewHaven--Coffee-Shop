# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string
ADMIN_EMAILS=you@example.com
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
RESET_PAGE_URL=http://127.0.0.1:5501/frontend/reset.html

# Email (leave SMTP_HOST empty to print emails in the terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# M-Pesa (Daraja sandbox)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=replace-with-a-long-random-string
MPESA_CALLBACK_URL=https://your-tunnel.ngrok-free.dev/payments/mpesa/callback/your-callback-secret